{
  "name": "agentshark",
  "version": "0.1.0",
  "description": "Inspect supported local coding-agent logs (Claude Code, Claude Cowork, Codex, Copilot Chat) from session timelines down to the original records.",
  "type": "module",
  "license": "MIT",
  "files": [
    "build/",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "agentshark": "build/bin/agentshark.js"
  },
  "scripts": {
    "start": "node bin/agentshark.ts serve",
    "index": "node bin/agentshark.ts index",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "desktop:build": "bash mac/scripts/build-app.sh"
  },
  "devDependencies": {
    "typescript": "5.9"
  }
}
