{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentShark Research Annotation",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "subjectId",
    "label",
    "author",
    "createdAt",
    "rubricVersion",
    "reviewed",
    "evidenceEventIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agentshark.annotation.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "subjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "rubricVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed": {
      "type": "boolean"
    },
    "evidenceEventIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "note": {
      "type": "string",
      "maxLength": 10000
    }
  }
}
